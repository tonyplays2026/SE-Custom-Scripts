{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-ingame-script.py\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Deploying script to in-game folder"
          }
        ]
      }
    ]
  }
}
